		id="Weather">
		<Rain
			RainTexture="FXRainDrop"
			IsRaining="true"
			NumRaindropsPerBox="2500"
			RainBoxWidth="1000.0"
			RainBoxLength="1000.0"
			RainBoxHeight="300.0"
			MinWidth="1"
			MaxWidth="4"
			MinHeight="25.0"
			MaxHeight="100.0"
			MinSpeed="250.0"
			MaxSpeed="270.0"
			MinAlpha=".3"
			MaxAlpha=".5"
