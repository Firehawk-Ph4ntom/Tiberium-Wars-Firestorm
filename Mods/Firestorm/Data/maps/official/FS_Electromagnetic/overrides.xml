<?xml version="1.0" encoding="UTF-8"?>
<AssetDeclaration
	xmlns="uri:ea.com:eala:asset"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Tags/>
	<Includes/>

	<!-- Snowy Weather -->
	<Weather
		id="Weather">
		<Rain
			RainTexture="FXSnowFlake"
			IsRaining="true"
			NumRaindropsPerBox="1200"
			RainBoxWidth="1500.0"
			RainBoxLength="1500.0"
			RainBoxHeight="450.0"
			MinWidth="1.0"
			MaxWidth="2.5"
			MinHeight="1.5"
			MaxHeight="4.0"
			MinSpeed="12.0"
			MaxSpeed="32.0"
			MinAlpha=".18"
			MaxAlpha=".45"
			WindStrength="10.0"/>
		<Lightning
			LightningEnabled="false"
			LightningDuration="1"
			LightningChance="0">
			<LightningFactor
				Type="UNIFORM"
				Low="0.0"
				High="0.0"/>
		</Lightning>
		<Spell
			SpellEnabled="true"
			SpellDuration="200"/>
		<Cloud>
			<CloudTextureSize x="660.0" y="660.0"/>
			<CloudOffsetPerSecond x="-.01" y="-.008"/>
		</Cloud>
		<WeatherData id="RAINY" HasLightning="false"/>
		<WeatherData id="CLOUDYRAINY" HasLightning="false"/>
		<WeatherData id="SUNNY" HasLightning="false"/>
		<WeatherData id="CLOUDY" HasLightning="false"/>
	</Weather>
</AssetDeclaration>