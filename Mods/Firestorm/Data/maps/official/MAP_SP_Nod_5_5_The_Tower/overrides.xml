	<!-- Increased reload time from 3.8s | Increased attack range significantly -->
	<WeaponTemplate
		id="GDIJuggernaughtArtilleryCannon"
		Name="GDIJuggernaughtArtilleryCannon"
		AttackRange="2250"
		ScatterLength="50"
		ScatterRadius="50"
		MinimumAttackRange="150"
		WeaponSpeed="500"
		MinTargetPitch="-30d"
		MaxTargetPitch="30d"
		FireFX="FX_GDI_JuggernaughtArtilleryFire"
		FireVeteranFX="FX_GDI_JuggernaughtArtilleryFireHeroic"
		ClipSize="3"
		ShotsPerBarrel="1"
		ReAcquireDetailType="PRE_FIRE"
		RequiredFiringObjectStatus="DEPLOYED"
		AntiMask="ANTI_GROUND ANTI_STRUCTURE"
		CheckStatusFlagsInRangeChecks="false"
		RotatingTurret="true">
		<ClipReloadTime
			MinSeconds="15s"
			MaxSeconds="20s"/>
		<Nuggets>
			<ProjectileNugget
				WarheadTemplate="GDIJuggernaughtArtilleryWarhead"
				ProjectileTemplate="GDIJuggernautArtilleryShell">
				<VeterancyProjectiles
					VeterancyLevel="HEROIC"
					ProjectileTemplate="GDIJuggernautArtilleryShell_Veteran"/>
			</ProjectileNugget>
		</Nuggets>
	</WeaponTemplate>

	<!-- Lowered damage from 750 -->
	<WeaponTemplate
		id="GDIJuggernaughtArtilleryWarhead"
		Name="GDIJuggernaughtArtilleryWarhead"
		AntiMask="ANTI_GROUND ANTI_STRUCTURE"
		RadiusDamageAffects="ENEMIES NEUTRALS NOT_SIMILAR"
		ProjectileCollidesWith="ENEMIES NEUTRAL">
		<Nuggets>
			<DamageNugget
				Damage="400"
				Radius="25"
				DamageType="GRENADE"
				DeathType="EXPLODED"
				DamageFXType="ALIEN_PLASMADISK"
				VictimShroudRevealer="ArtilleryShroudRevealer">
				<DamageScalarDetails
					Scalar="75%">
					<Filter
						Rule="ALL"
						Exclude="INFANTRY STRUCTURE"/>
				</DamageScalarDetails>
				<DamageScalarDetails
					Scalar="0%">
					<Filter
						Rule="NONE"
						Relationship="ALLIES">
						<IncludeThing>NODShadowSquadBeacon</IncludeThing>
					</Filter>
				</DamageScalarDetails>
			</DamageNugget>
			<SuppressionNugget
				Radius="100"
				Suppression="100"
				DurationSeconds="5s"/>
		</Nuggets>
	</WeaponTemplate>

